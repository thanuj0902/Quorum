# Copy this file to .env and fill in your API keys
# GROQ_API_KEY: Groq key A — Research + Synthesizer agents
# GROQ_API_KEY_2: Groq key B — Verifier agent
# GROQ_API_KEY_3: Groq key C — Contradiction agent
# All keys are free at: https://console.groq.com
GROQ_API_KEY=gsk-your-groq-api-key-a
GROQ_API_KEY_2=gsk-your-groq-api-key-b
GROQ_API_KEY_3=gsk-your-groq-api-key-c
